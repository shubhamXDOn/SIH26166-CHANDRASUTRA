# ============================================================
# SIH26166 — environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Application ---
APP_ENV=development            # development | production
APP_DEBUG=true                 # enables verbose logging / detailed errors
APP_VERSION=0.1.0

# --- Backend runtime ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- CORS: comma-separated origins allowed to call the backend ---
# Frontend dev server and any deployed UI origin go here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- Security (required for real authentication in later milestones) ---
# Generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=60
AUTH_ALGORITHM=HS256

# --- AI / Gemini (optional in M0) ---
# The backend reads this key and talks to Gemini. It is NEVER sent to the browser.
# If empty, the AI service reports status NOT_CONFIGURED and the app still runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Data locations (optional overrides; defaults resolve under ./data) ---
# DATA_ROOT=