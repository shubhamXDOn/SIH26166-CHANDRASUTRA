# ============================================================
# SIH26166 — environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Application ---
APP_ENV=development             # development | production
APP_DEBUG=true                  # enables verbose logging / detailed error bodies
APP_VERSION=0.11.0

# --- Backend runtime ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- M11 hardening knobs ---
# Maximum accepted request body in bytes; over-limit requests get an honest
# 413 LIMIT_EXCEEDED envelope before any pipeline code runs.
HTTP_MAX_BODY_BYTES=8000000
# A pipeline run whose lock file is older than this many seconds is treated as
# interrupted (crash/restart) and reconciled honestly before the next run.
RUN_STALE_BUDGET_SECONDS=600
# Puts a persistent "Synthetic demonstration — not a real lunar observation"
# marker on the UI/API. Never fabricates real-looking results.
DEMO_MODE=false
# HTTP header used/echoed for request correlation.
REQUEST_ID_HEADER=x-request-id

# --- CORS: comma-separated origins allowed to call the backend ---
# Frontend dev server and any deployed UI origin go here. When served through
# the frontend nginx reverse proxy the UI is same-origin (/api), but deployments
# that call the API directly must list every browser origin explicitly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# --- Logging ---
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR

# --- Authentication (M10) ---
# AUTH_SECRET_KEY is REQUIRED for authentication. While it is empty every
# protected endpoint fails closed with 501 AUTH_NOT_CONFIGURED and the app
# still starts. Generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256

# Access token lifetime (seconds). Short-lived on purpose — refresh is via the
# HttpOnly cookie below. 900s is the default.
AUTH_ACCESS_TTL_SECONDS=900

# Refresh session lifetime (seconds). Each POST /api/auth/refresh rotates the
# token and revokes the previous one.
AUTH_REFRESH_TTL_SECONDS=604800

# Allow visitors to self-register (account is created disabled and needs an
# admin to activate it when registration_tls/approval mode is on).
AUTH_REGISTER_ENABLED=true

# Bootstrap administrator created on first startup (empty = skip).
# Use a strong unique password; these values are read from the environment only.
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Refresh cookie transport (tune only when you know why you are changing it).
AUTH_REFRESH_COOKIE_NAME=chandrasutra_refresh
# Force-secure is automatic in production (APP_ENV=production); override here
# only for local HTTPS testing.
#AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict

# Persistent account database (defaults under DATA_ROOT/auth/auth.db).
#AUTH_DB_PATH=

# --- AI / Gemini ---
# The backend reads this key and talks to Gemini. It is NEVER sent to the
# browser. If empty, the AI service reports status NOT_CONFIGURED and the app
# still runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Data locations (optional overrides; defaults resolve under ./data) ---
# DATA_ROOT=